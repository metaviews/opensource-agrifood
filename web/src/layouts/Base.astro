---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Building the Open-Source Future of Canadian Agrifood',
  description = 'A Future Herd spectacular event on AI and agrifood.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://opensource.thefutureherd.ca/" />
    <link rel="canonical" href="https://opensource.thefutureherd.ca/" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Future Herd Open Source Agrifood home">
        <span>Future Herd</span>
        <span class="wordmark-mark">/</span>
        <span>Open Source Agrifood</span>
      </a>
      <nav class="site-nav" aria-label="Primary navigation">
        <a href="/research">The research</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-mark">Building the Open-Source Future of Canadian Agrifood</div>
        <div class="footer-links" aria-label="Related sites">
          <a class="partner-link" href="https://thefutureherd.ca">
            <img src="/partners/future-herd.png" alt="Future Herd" />
            <span>Future Herd</span>
          </a>
          <a class="partner-link" href="https://metaviews.ca">
            <img src="/partners/metaviews.png" alt="metaviews.ca" />
            <span>metaviews.ca</span>
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #18241f;
    --ink-soft: #4d5e56;
    --ink-faint: #73837b;
    --paper: #f4f0e7;
    --paper-warm: #e8e1d2;
    --moss: #496552;
    --moss-dark: #263d2e;
    --ochre: #c87737;
    --pink: #dba9a0;
    --line: rgba(24, 36, 31, 0.18);
    --display: Georgia, 'Times New Roman', serif;
    --body: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  * { box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--body);
    line-height: 1.6;
  }

  a { color: inherit; }

  .site-header,
  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 86rem;
    margin: 0 auto;
    padding: 1.25rem clamp(1.25rem, 4vw, 4rem);
  }

  .site-header { border-bottom: 1px solid var(--line); }

  .wordmark {
    display: inline-flex;
    gap: 0.4rem;
    align-items: baseline;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .wordmark-mark { color: var(--ochre); font-size: 1.2rem; }
  .site-nav a { color: var(--moss); font-size: 0.78rem; font-weight: 700; text-decoration: none; }
  .site-nav a:hover { color: var(--ochre); }
  .site-footer { color: var(--ink-faint); font-size: 0.78rem; }

  .site-footer {
    display: block;
    border-top: 1px solid var(--line);
    margin-top: 2rem;
    padding-top: 2.5rem;
    padding-bottom: 2.75rem;
  }

  .footer-inner { max-width: 86rem; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: 0 clamp(1.25rem, 4vw, 4rem); }
  .footer-mark { max-width: 22rem; color: var(--ink); font-family: var(--display); font-size: 1.2rem; line-height: 1.15; }
  .footer-links { display: flex; align-items: center; gap: 1.5rem; }
  .partner-link { display: flex; align-items: center; gap: 0.65rem; color: var(--ink-soft); font-size: 0.78rem; text-decoration: none; }
  .partner-link:hover { color: var(--moss-dark); }
  .partner-link img { display: block; width: 2.3rem; height: 2.3rem; object-fit: contain; filter: saturate(0.7); }
  .partner-link:nth-child(2) img { width: 5.5rem; height: 2.3rem; }

  @media (max-width: 600px) {
    .wordmark { font-size: 0.68rem; }
    .site-nav a { font-size: 0.7rem; }
    .footer-inner, .footer-links { align-items: flex-start; flex-direction: column; }
    .footer-links { gap: 0.9rem; }
  }
</style>
