---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Building the Open-Source Future of Canadian Agrifood',
  description = 'A Future Herd spectacular event on AI and agrifood.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://opensource.thefutureherd.ca/" />
    <link rel="canonical" href="https://opensource.thefutureherd.ca/" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Future Herd Open Source Agrifood home">
        <span>Future Herd</span>
        <span class="wordmark-mark">/</span>
        <span>Open Source Agrifood</span>
      </a>
      <span class="header-note">A spectacular event</span>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>Future Herd</span>
      <span>·</span>
      <span>opensource-agrifood</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #18241f;
    --ink-soft: #4d5e56;
    --ink-faint: #73837b;
    --paper: #f4f0e7;
    --paper-warm: #e8e1d2;
    --moss: #496552;
    --moss-dark: #263d2e;
    --ochre: #c87737;
    --pink: #dba9a0;
    --line: rgba(24, 36, 31, 0.18);
    --display: Georgia, 'Times New Roman', serif;
    --body: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  * { box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--body);
    line-height: 1.6;
  }

  a { color: inherit; }

  .site-header,
  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 86rem;
    margin: 0 auto;
    padding: 1.25rem clamp(1.25rem, 4vw, 4rem);
  }

  .site-header { border-bottom: 1px solid var(--line); }

  .wordmark {
    display: inline-flex;
    gap: 0.4rem;
    align-items: baseline;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .wordmark-mark { color: var(--ochre); font-size: 1.2rem; }
  .header-note, .site-footer { color: var(--ink-faint); font-size: 0.78rem; }

  .site-footer {
    justify-content: flex-start;
    border-top: 1px solid var(--line);
    margin-top: 2rem;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
  }

  @media (max-width: 600px) {
    .header-note { display: none; }
    .wordmark { font-size: 0.68rem; }
  }
</style>
