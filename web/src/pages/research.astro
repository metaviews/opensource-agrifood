  blockquote { max-width: 64rem; margin: 1rem 0 2rem 20%; }
  blockquote p { color: var(--moss-dark); font-family: var(--display); font-size: clamp(1.7rem, 3.5vw, 3.5rem); letter-spacing: -0.045em; line-height: 1.08; }
